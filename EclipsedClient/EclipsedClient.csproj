<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Solarious</AssemblyName>
    <RootNamespace>EclipsedClient</RootNamespace>
    <Product>Solarious</Product>
    <Description>Privacy-first Windows launcher for the official Roblox player</Description>
    <Copyright>Copyright © 2022 pizzaboxer and © 2026 Eclipsed Client contributors</Copyright>
    <ApplicationIcon>..\Images\assets\Solarious.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="..\Images\assets\Solarious.ico" Link="Assets\Solarious.ico" />
    <Resource Include="..\Images\assets\solarious.png" Link="Assets\solarious.png" />
    <Resource Include="..\Images\assets\earthrise.jpg" Link="Assets\earthrise.jpg" />
    <Resource Include="..\Images\assets\solar-corona.jpg" Link="Assets\solar-corona.jpg" />
    <Resource Include="..\Images\assets\hadley-apennine.jpg" Link="Assets\hadley-apennine.jpg" />
    <Resource Include="..\LICENSE" Link="Assets\LICENSE" />
    <Resource Include="..\THIRD-PARTY-NOTICES" Link="Assets\THIRD-PARTY-NOTICES" />
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Resource Include="Notices\*.txt" />
    <PackageReference Include="DiscordRichPresence" Version="1.2.1.24" />
  </ItemGroup>
</Project>
