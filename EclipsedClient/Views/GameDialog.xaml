<Window x:Class="EclipsedClient.Views.GameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit saved game" WindowStartupLocation="CenterOwner" SizeToContent="Height" Width="450"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="Transparent" Foreground="{StaticResource Text}" FontFamily="Segoe UI">
    <Border Style="{StaticResource Card}" Background="{StaticResource Spotlight}" Padding="0" CornerRadius="12">
        <StackPanel Margin="23">
            <TextBlock x:Name="Heading" Style="{StaticResource Section}" Margin="0,0,0,13" />
            <StackPanel x:Name="PlaceFields">
                <TextBlock Text="Roblox experience URL or Place ID" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Play" Command="{Binding Play}" Margin="8,0,0,0" />
                    <TextBox x:Name="PlaceInput" Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" MaxLength="2048"
                             AutomationProperties.Name="Roblox experience URL or Place ID">
                        <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding Play}" /></TextBox.InputBindings>
                    </TextBox>
                </DockPanel>
                <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                    <Image Source="{Binding Icon}" MaxWidth="32" MaxHeight="32" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding Caption}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
            <TextBlock Text="Title" Style="{StaticResource MutedText}" Margin="0,5,0,4" />
            <TextBox x:Name="GameTitle" MaxLength="80" AutomationProperties.Name="Title" />
            <TextBlock Text="Notes" Style="{StaticResource MutedText}" Margin="0,5,0,4" />
            <TextBox x:Name="Notes" MaxLength="500" AutomationProperties.Name="Notes" Height="76"
                     TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />
            <TextBlock Text="Accent color (#RRGGBB)" Style="{StaticResource MutedText}" Margin="0,5,0,4" />
            <TextBox x:Name="AccentColor" MaxLength="7" AutomationProperties.Name="Accent color" />
            <TextBlock x:Name="Validation" Foreground="{StaticResource Amber}" Margin="0,8,0,0"
                       AutomationProperties.LiveSetting="Polite" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" />
                <Button Content="Save game" IsDefault="True" Click="Save" Style="{StaticResource Primary}" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
