<UserControl x:Class="EclipsedClient.Views.PlaytimeView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<StackPanel Margin="28,25,28,28">
<TextBlock Text="Playtime" Style="{StaticResource Heading}" /><TextBlock Text="Your Roblox sessions while Eclipsed Client was open." Style="{StaticResource MutedText}" Margin="0,0,0,22" />
<ItemsControl ItemsSource="{Binding Stats}" ItemsPanel="{StaticResource EqualColumns}" Margin="0,0,-10,15">
<ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Background="{StaticResource Spotlight}" Margin="0,0,10,0" Padding="16">
  <StackPanel><TextBlock Text="{Binding Label}" Style="{StaticResource Kicker}" /><TextBlock Text="{Binding Value}" Style="{StaticResource Metric}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Value}" /></StackPanel>
</Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
<Border Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel>
  <DockPanel><CheckBox DockPanel.Dock="Right" Content="Weekly view" IsChecked="{Binding ShowWeekly}" VerticalAlignment="Center" Margin="0" />
  <TextBlock Text="Playtime history" Style="{StaticResource Section}" /></DockPanel>
  <ItemsControl ItemsSource="{Binding Bars}" ItemsPanel="{StaticResource EqualColumns}" Margin="0,13,0,0">
<ItemsControl.ItemTemplate><DataTemplate>
  <StackPanel ToolTip="{Binding Value}" AutomationProperties.Name="{Binding Value}" Margin="5,0">
    <Grid Height="135" Background="{StaticResource Inset}">
      <Border Height="{Binding Height}" VerticalAlignment="Bottom" MaxWidth="52" CornerRadius="4,4,1,1">
        <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#E6C8FF" Offset="0" /><GradientStop Color="#7654AB" Offset="1" /></LinearGradientBrush></Border.Background>
      </Border>
    </Grid>
    <TextBlock Text="{Binding Label}" FontSize="12" TextAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,6,0,0" />
  </StackPanel>
</DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
</StackPanel></Border>
<Border Style="{StaticResource Card}"><StackPanel>
  <TextBlock Text="Peak gaming hours" Style="{StaticResource Section}" />
  <TextBlock Text="{Binding Peak}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
  <ItemsControl ItemsSource="{Binding Hours}" ItemsPanel="{StaticResource EqualColumns}" Margin="0,13,0,0">
<ItemsControl.ItemTemplate><DataTemplate>
  <StackPanel ToolTip="{Binding Value}" AutomationProperties.Name="{Binding Value}" Margin="2,0">
    <Grid Height="83" Background="{StaticResource Inset}">
      <Border Height="{Binding Height}" VerticalAlignment="Bottom" MaxWidth="24" CornerRadius="4,4,1,1">
        <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#E6C8FF" Offset="0" /><GradientStop Color="#7654AB" Offset="1" /></LinearGradientBrush></Border.Background>
      </Border>
    </Grid>
    <TextBlock Text="{Binding Label}" FontSize="9" TextAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,6,0,0" />
  </StackPanel>
</DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
</StackPanel></Border></StackPanel>
</UserControl>
