<UserControl x:Class="EclipsedClient.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="28,25,28,28">
        <TextBlock Text="Settings &amp; privacy" Style="{StaticResource Heading}" />
        <TextBlock Text="Manage how Eclipsed Client runs and where it stores your data." Style="{StaticResource MutedText}" Margin="0,0,0,21" />
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Margin="0,0,15,0">
                <StackPanel>
                    <TextBlock Text="Roblox launch" Style="{StaticResource Section}" />
                    <Border Style="{StaticResource Badge}" HorizontalAlignment="Left" Margin="0,9,0,13">
                        <TextBlock Text="{Binding Mode}" Foreground="{StaticResource Lavender}" />
                    </Border>
                    <CheckBox Content="Use the system tray when minimizing or launching" IsChecked="{Binding MinimizeAfterLaunch}" />
                    <CheckBox Content="Use Windows URI fallback if direct launch fails" IsChecked="{Binding AllowUriFallback}"
                              ToolTip="Windows may route the link to another installed launcher." />
                    <WrapPanel>
                        <Button Content="Set as default" Command="{Binding Register}" Margin="0,0,7,6" />
                        <Button Content="Restore previous handler" Command="{Binding Restore}" IsEnabled="{Binding Registered, Mode=OneWay}" Margin="0,0,0,6" />
                    </WrapPanel>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Data &amp; privacy" Style="{StaticResource Section}" />
                    <TextBlock Text="Eclipsed Client uses no analytics, crash reporting, Roblox login, or cookies."
                               Style="{StaticResource MutedText}" Margin="0,7,0,11" />
                    <TextBlock Text="Launcher files" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Storage}" Foreground="{StaticResource Lavender}" Margin="0,3,0,8" />
                    <TextBlock Text="Screenshots" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ScreenshotsPath}" Foreground="{StaticResource Lavender}" Margin="0,3,0,8" />
                    <TextBlock Text="Charts, public lookups and friend presence use Roblox services. Discord presence and ping run when enabled or requested."
                               Style="{StaticResource MutedText}" />
                </StackPanel>
            </Border>
        </Grid>
        <Border Style="{StaticResource Card}" Background="{StaticResource Spotlight}" Margin="0,15,0,0">
            <StackPanel>
                <TextBlock Text="{Binding Version}" Style="{StaticResource Section}" />
                <TextBlock Text="Eclipsed Client is an independent MIT-licensed fork of Bloxstrap. It is not affiliated with Roblox Corporation, Bloxstrap Labs, or Moonsworth."
                           Style="{StaticResource MutedText}" Margin="0,8,0,5" />
                <TextBlock Text="Copyright © 2022 pizzaboxer · Copyright © 2026 Eclipsed Client contributors"
                           Style="{StaticResource MutedText}" Margin="0,0,0,13" />
                <WrapPanel>
                    <Button Content="Licenses &amp; notices" Command="{Binding Notices}" Margin="0,0,8,0" />
                    <Button Content="GitHub releases" Command="{Binding Releases}" Margin="0,0,8,0" />
                    <Button Content="Bloxstrap source" Command="{Binding Source}" />
                </WrapPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
