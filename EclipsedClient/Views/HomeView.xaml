<UserControl x:Class="EclipsedClient.Views.HomeView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Border Background="{StaticResource Canvas}">
            <Grid Height="320">
                <Border>
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding DataContext.Settings.BackdropImage, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Viewbox="{Binding DataContext.Settings.BackdropCrop, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Stretch="UniformToFill" AlignmentX="Right" AlignmentY="Center" />
                    </Border.Background>
                </Border>
                <Border IsHitTestVisible="False">
                    <Border.Background>
                    <LinearGradientBrush StartPoint="0,.5" EndPoint="1,.5">
                        <GradientStop Color="#FF10141B" Offset="0" />
                        <GradientStop Color="#F110141B" Offset=".27" />
                        <GradientStop Color="#6810141B" Offset=".54" />
                        <GradientStop Color="#2410141B" Offset="1" />
                    </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Border IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#0012151C" Offset=".52" />
                            <GradientStop Color="#ED12151C" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" Margin="39,0,0,18">
                    <TextBlock Text="Roblox" FontSize="64" FontWeight="Bold" Margin="0,0,0,7" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock Text="{Binding Installation}" FontSize="12" Foreground="#D0D8E6" VerticalAlignment="Center" />
                        <Button Content="&#xE72C;" FontFamily="Segoe MDL2 Assets" Padding="7,2" MinHeight="26" Margin="8,0,0,0"
                                ToolTip="Refresh Roblox installation status" AutomationProperties.Name="Refresh installation status" Command="{Binding Scan}" />
                    </StackPanel>
                    <Button Content="▶   Play Roblox" MinWidth="204" Height="46" FontSize="15"
                            Command="{Binding DataContext.Launch, RelativeSource={RelativeSource AncestorType=Window}}"
                            Style="{StaticResource Primary}" HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding Session}" Foreground="#D0D8E6" FontSize="11" Margin="0,10,0,0" />
                </StackPanel>
                <Border Style="{StaticResource SoftCard}" Padding="4" CornerRadius="12" HorizontalAlignment="Right"
                        VerticalAlignment="Bottom" Margin="0,0,28,33"
                        DataContext="{Binding DataContext.Settings, RelativeSource={RelativeSource AncestorType=Window}}">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="&#xE76B;" FontFamily="Segoe MDL2 Assets" Command="{Binding PreviousBackdrop}" MinHeight="25"
                                Padding="6,3" ToolTip="Previous NASA backdrop" AutomationProperties.Name="Previous NASA backdrop" />
                        <TextBlock Text="{Binding BackdropTitle}" VerticalAlignment="Center" Margin="9,0" FontSize="11" />
                        <Button Content="&#xE76C;" FontFamily="Segoe MDL2 Assets" Command="{Binding NextBackdrop}" MinHeight="25"
                                Padding="6,3" ToolTip="Next NASA backdrop" AutomationProperties.Name="Next NASA backdrop" />
                    </StackPanel>
                </Border>
                <TextBlock Text="{Binding DataContext.Settings.BackdropCredit, RelativeSource={RelativeSource AncestorType=Window}}"
                           HorizontalAlignment="Right" VerticalAlignment="Bottom" Foreground="#EDF1FA" FontSize="10" Margin="0,0,30,15">
                    <TextBlock.Effect><DropShadowEffect ShadowDepth="1" BlurRadius="5" Opacity=".9" /></TextBlock.Effect>
                </TextBlock>
            </Grid>
        </Border>
        <Border Style="{StaticResource SoftCard}" Padding="11" Margin="28,0,28,24" DataContext="{Binding Entry}">
            <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Quick Play" Command="{Binding Play}" Margin="7,0,0,0" />
                    <Button DockPanel.Dock="Right" Content="&#xE77F;" FontFamily="Segoe MDL2 Assets"
                            Click="PastePlace" ToolTip="Paste Roblox link or Place ID" AutomationProperties.Name="Paste Roblox link or Place ID" Margin="7,0,0,0" />
                    <Grid>
                        <TextBox x:Name="QuickInput" Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" MaxLength="29999" PreviewMouseLeftButtonDown="PasteOnClick"
                                 AutomationProperties.Name="Roblox experience URL or Place ID">
                            <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding Play}" /></TextBox.InputBindings>
                        </TextBox>
                        <TextBlock Text="Paste a Roblox link or Place ID" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False">
                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=QuickInput}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger></Style.Triggers>
                            </Style></TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DockPanel>
                <StackPanel Orientation="Horizontal">
                    <Image Source="{Binding Icon}" MaxWidth="26" MaxHeight="26" />
                    <TextBlock Text="{Binding Caption}" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="7,0,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>
        <StackPanel Margin="28,0,28,20">
        <DockPanel Margin="0,0,0,13">
            <Button DockPanel.Dock="Right" Content="+ Add game" Command="{Binding Add}" Margin="7,0,0,0" />
            <Grid DockPanel.Dock="Right" Width="150">
                <TextBox x:Name="LibrarySearch" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search game library" />
                <TextBlock Text="Search library" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False">
                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=LibrarySearch}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger></Style.Triggers>
                            </Style></TextBlock.Style>
                        </TextBlock>
            </Grid>
            <TextBlock Text="Library" FontSize="27" FontWeight="SemiBold" VerticalAlignment="Center" />
        </DockPanel>
        <Border Style="{StaticResource SoftCard}" Padding="21" Visibility="{Binding EmptyGames}">
            <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Browse Top Charts" VerticalAlignment="Center" Margin="12,0,0,0"
                            Command="{Binding DataContext.OpenDiscover, RelativeSource={RelativeSource AncestorType=Window}}" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding EmptyGameTitle}" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding EmptyGameHint}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>
        <ItemsControl ItemsSource="{Binding Games}" SizeChanged="ResizeLibrary" Margin="0,0,-10,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Columns="{Binding LibraryColumns, RelativeSource={RelativeSource AncestorType=UserControl}}" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate><DataTemplate>
                <Border x:Name="GameCard" Style="{StaticResource LibraryTile}" Margin="0,0,10,10"
                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <Border.ContextMenu>
                        <ContextMenu ItemContainerStyle="{StaticResource GameMenuItem}" Style="{StaticResource GameContextMenu}" DataContext="{Binding PlacementTarget, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="Edit title and notes" Command="{Binding Tag.Edit}" CommandParameter="{Binding DataContext}" />
                            <MenuItem Header="Copy game link" Command="{Binding Tag.CopyLink}" CommandParameter="{Binding DataContext}" />
                            <MenuItem Header="{Binding DataContext.PinLabel}" Command="{Binding Tag.TogglePin}" CommandParameter="{Binding DataContext}" />
                            <MenuItem Header="Open Roblox page" Command="{Binding Tag.OpenGame}" CommandParameter="{Binding DataContext}" />
                            <MenuItem Header="Remove" Command="{Binding Tag.Remove}" CommandParameter="{Binding DataContext}" />
                        </ContextMenu>
                    </Border.ContextMenu>
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="128" /><RowDefinition Height="51" /></Grid.RowDefinitions>
                        <Border CornerRadius="8" Background="{StaticResource Spotlight}">
                            <Image Source="{StaticResource EclipseMoon}" Width="35" Height="35" Opacity=".4" />
                        </Border>
                        <Border CornerRadius="8">
                            <Border.Background><ImageBrush ImageSource="{Binding Icon}" Stretch="UniformToFill" Opacity=".79" /></Border.Background>
                        </Border>
                        <Border Style="{StaticResource Badge}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8"
                                Visibility="{Binding Game.Pinned, Converter={StaticResource BoolVisible}}">
                            <TextBlock Text="Pinned" FontSize="10" Foreground="{StaticResource Lavender}" />
                        </Border>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8">
                            <Button Content="▶  Play" Command="{Binding DataContext.Play, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource Primary}" Margin="0,0,5,0" />
                            <Button Content="&#xE712;" FontFamily="Segoe MDL2 Assets" ToolTip="Game actions" AutomationProperties.Name="Game actions" Tag="{Binding ElementName=GameCard}" Click="OpenGameMenu" />
                        </StackPanel>
                        <DockPanel Grid.Row="1" Margin="3,8,3,0" VerticalAlignment="Center">
                            <Border DockPanel.Dock="Left" Width="3" CornerRadius="1.5" Background="{Binding Accent}" Margin="0,2,8,2" />
                            <StackPanel>
                            <TextBlock Text="{Binding Title}" ToolTip="{Binding Title}" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Notes}" ToolTip="{Binding Notes}" Foreground="{StaticResource Muted}" FontSize="11"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DockPanel>
                    </Grid>
                </Border>
            </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        </StackPanel>
    </StackPanel>
</UserControl>
