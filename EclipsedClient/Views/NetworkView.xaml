<UserControl x:Class="EclipsedClient.Views.NetworkView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Network" Style="{StaticResource Heading}" />
        <TextBlock Text="See which Roblox server you’re connected to and check its latency." Style="{StaticResource MutedText}" Margin="0,0,0,14" />
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <DockPanel>
                    <TextBlock Text="&#xE968;" DockPanel.Dock="Left" Style="{StaticResource IconText}" Margin="0,0,11,0" />
                    <TextBlock Text="Current server" Style="{StaticResource Section}" />
                </DockPanel>
                <UniformGrid Rows="1" Margin="0,16,-10,0">
                    <Border Style="{StaticResource SoftCard}" Margin="0,0,10,0" Padding="14">
                        <StackPanel><TextBlock Text="Server IP" Style="{StaticResource MutedText}" />
                            <TextBlock Text="{Binding Address}" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0" /></StackPanel>
                    </Border>
                    <Border Style="{StaticResource SoftCard}" Margin="0,0,10,0" Padding="14">
                        <StackPanel><TextBlock Text="Region" Style="{StaticResource MutedText}" />
                            <TextBlock Text="{Binding Region}" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0" /></StackPanel>
                    </Border>
                    <Border Style="{StaticResource SoftCard}" Margin="0,0,10,0" Padding="14">
                        <StackPanel><TextBlock Text="Place ID" Style="{StaticResource MutedText}" />
                            <TextBlock Text="{Binding Place}" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0" /></StackPanel>
                    </Border>
                </UniformGrid>
            </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
            <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Run ping test" Command="{Binding Ping}" IsEnabled="{Binding Connected, Mode=OneWay}"
                            Style="{StaticResource Primary}" VerticalAlignment="Center" Margin="12,0,0,0" />
                    <StackPanel>
                        <TextBlock Text="Latency" Style="{StaticResource Section}" />
                        <TextBlock Text="Sends one ping to the current server. Some servers block ping requests." Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                    </StackPanel>
                </DockPanel>
                <TextBlock Text="{Binding Result}" Foreground="{StaticResource Lavender}" Margin="0,10,0,0" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
