<UserControl x:Class="EclipsedClient.Views.GalleryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Captures" Style="{StaticResource Heading}" />
        <TextBlock Text="Browse captures from your local Roblox folder." Style="{StaticResource MutedText}" Margin="0,0,0,14" />
        <Border Style="{StaticResource Card}" Padding="13" Margin="0,0,0,16">
            <DockPanel>
                <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0">
                    <CheckBox Content="Oldest first" IsChecked="{Binding OldestFirst}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Button Content="Refresh" Command="{Binding Refresh}" Margin="0,0,7,0" />
                    <Button Content="Open folder" Command="{Binding OpenFolder}" />
                </WrapPanel>
                <Grid>
                    <TextBox x:Name="CaptureSearch" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search screenshots" />
                    <TextBlock Text="Search screenshots" IsHitTestVisible="False" VerticalAlignment="Center" Margin="11,0,0,0">
                        <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=CaptureSearch}" Value="">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger></Style.Triggers>
                        </Style></TextBlock.Style>
                    </TextBlock>
                </Grid>
            </DockPanel>
        </Border>
        <DockPanel Margin="0,0,0,13">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Previous" Command="{Binding Previous}" IsEnabled="{Binding HasPrevious, Mode=OneWay}" Margin="0,0,7,0" />
                <Button Content="Next" Command="{Binding Next}" IsEnabled="{Binding HasNext, Mode=OneWay}" />
            </StackPanel>
            <TextBlock Text="{Binding Summary}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
        </DockPanel>
        <ItemsControl ItemsSource="{Binding Cards}" ItemsPanel="{StaticResource WrapCards}">
            <ItemsControl.ItemTemplate><DataTemplate>
                <Border Style="{StaticResource Card}" Width="201" Margin="0,0,14,14" Padding="10">
                    <StackPanel>
                        <Button Command="{Binding DataContext.Preview, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" Padding="0" Background="{StaticResource Inset}"
                                AutomationProperties.Name="Open full-size screenshot">
                            <Border Width="178" Height="112" CornerRadius="11">
                                <Border.Background><ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" /></Border.Background>
                            </Border>
                        </Button>
                        <TextBlock Text="{Binding Name}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Name}" FontWeight="SemiBold" Margin="2,9,2,0" />
                        <DockPanel Margin="2,4,0,0">
                            <Button DockPanel.Dock="Right" Content="&#xE8C8;" FontFamily="Segoe MDL2 Assets" Padding="8,5"
                                    Command="{Binding DataContext.Copy, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" ToolTip="Copy to clipboard" AutomationProperties.Name="Copy screenshot" />
                            <TextBlock Text="{Binding Date}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                        </DockPanel>
                    </StackPanel>
                </Border>
            </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
