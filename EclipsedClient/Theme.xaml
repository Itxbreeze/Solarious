<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<SolidColorBrush x:Key="Canvas" Color="#12151C" />
<SolidColorBrush x:Key="Panel" Color="#1C212C" />
<SolidColorBrush x:Key="Line" Color="#303746" />
<SolidColorBrush x:Key="Text" Color="#F0F3FA" />
<SolidColorBrush x:Key="Muted" Color="#A2ABBD" />
<SolidColorBrush x:Key="Accent" Color="#D6AA70" />
<SolidColorBrush x:Key="Hover" Color="#E2BA86" />
<SolidColorBrush x:Key="Lavender" Color="#E1BD8F" />
<SolidColorBrush x:Key="Amber" Color="#E7BF7D" />
<BooleanToVisibilityConverter x:Key="BoolVisible" />
<SolidColorBrush x:Key="Rail" Color="#171B24" />
<SolidColorBrush x:Key="Inset" Color="#171B24" />
<SolidColorBrush x:Key="AccentInk" Color="#23190F" />
<SolidColorBrush x:Key="Success" Color="#A6DDBA" />
<LinearGradientBrush x:Key="Spotlight" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#2D2934" Offset="0" />
    <GradientStop Color="#242430" Offset=".58" />
    <GradientStop Color="#1A1D27" Offset="1" />
</LinearGradientBrush>
<LinearGradientBrush x:Key="LaunchGradient" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#E0B67D" Offset="0" />
    <GradientStop Color="#CFA066" Offset="1" />
</LinearGradientBrush>
<Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Text}" />
<Setter Property="TextWrapping" Value="Wrap" /></Style>
<Style x:Key="MutedText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Foreground" Value="{StaticResource Muted}" />
<Setter Property="FontSize" Value="13" />
<Setter Property="LineHeight" Value="21" /></Style>
<Style x:Key="Kicker" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Foreground" Value="{StaticResource Lavender}" />
<Setter Property="FontSize" Value="11" />
<Setter Property="FontWeight" Value="Bold" /></Style>
<Style x:Key="Heading" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="FontSize" Value="32" />
<Setter Property="FontWeight" Value="SemiBold" />
<Setter Property="Margin" Value="0,0,0,8" /></Style>
<Style x:Key="Section" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="FontSize" Value="21" />
<Setter Property="FontWeight" Value="SemiBold" /></Style>
<Style x:Key="Metric" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="FontSize" Value="24" />
<Setter Property="FontWeight" Value="SemiBold" />
<Setter Property="Margin" Value="0,7,0,0" /></Style>
<Style x:Key="Card" TargetType="Border">
<Setter Property="Background" Value="{StaticResource Panel}" />
<Setter Property="BorderBrush" Value="{StaticResource Line}" />
<Setter Property="BorderThickness" Value="1" />
<Setter Property="CornerRadius" Value="12" />
<Setter Property="Padding" Value="22" />
</Style>
<Style TargetType="Button">
<Setter Property="Background" Value="#252C39" />
<Setter Property="Foreground" Value="{StaticResource Text}" />
<Setter Property="BorderBrush" Value="#394454" />
<Setter Property="Padding" Value="13,8" />
<Setter Property="MinHeight" Value="34" />
<Setter Property="Cursor" Value="Hand" />
<Setter Property="FontWeight" Value="SemiBold" />
<Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
<Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}">
<Grid>
<Border x:Name="HoverLayer" Background="#E6C79E" Opacity="0" CornerRadius="10" IsHitTestVisible="False" />
<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}" />
</Grid>
</Border>
<ControlTemplate.Triggers>
<Trigger Property="IsMouseOver" Value="True">
    <Setter TargetName="Face" Property="BorderBrush" Value="#A98761" />
    <Trigger.EnterActions><BeginStoryboard><Storyboard>
        <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To=".09" Duration="0:0:.12" />
    </Storyboard></BeginStoryboard></Trigger.EnterActions>
    <Trigger.ExitActions><BeginStoryboard><Storyboard>
        <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:.12" />
    </Storyboard></BeginStoryboard></Trigger.ExitActions>
</Trigger>
<Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource Text}" /></Trigger>
<Trigger Property="IsPressed" Value="True"><Setter TargetName="Face" Property="Opacity" Value=".75" /></Trigger>
<Trigger Property="IsEnabled" Value="False"><Setter TargetName="Face" Property="Opacity" Value=".4" /></Trigger>
</ControlTemplate.Triggers>
</ControlTemplate></Setter.Value></Setter></Style>
<Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
<Setter Property="Background" Value="{StaticResource LaunchGradient}" />
<Setter Property="BorderBrush" Value="#CEA36C" />
<Setter Property="Foreground" Value="{StaticResource AccentInk}" />
<Setter Property="ContentTemplate">
    <Setter.Value>
        <DataTemplate>
            <TextBlock Text="{Binding}" Foreground="{StaticResource AccentInk}" />
        </DataTemplate>
    </Setter.Value>
</Setter>
<Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#E7BF89" /></Trigger></Style.Triggers>
</Style>
<Style x:Key="ProfileButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{StaticResource Panel}" />
    <Setter Property="BorderBrush" Value="{StaticResource Line}" />
    <Setter Property="Padding" Value="7" />
</Style>
<Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Foreground" Value="#E4ACA4" />
</Style>
<Style x:Key="ChromeButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
<Setter Property="Width" Value="44" />
<Setter Property="MinHeight" Value="32" />
<Setter Property="Background" Value="Transparent" />
<Setter Property="BorderBrush" Value="Transparent" />
<Setter Property="Padding" Value="0" />
<Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
<Setter Property="FontSize" Value="10" />
</Style>
<Style TargetType="TextBox"><Setter Property="Background" Value="#121720" />
<Setter Property="Foreground" Value="{StaticResource Text}" />
<Setter Property="CaretBrush" Value="{StaticResource Text}" />
<Setter Property="BorderBrush" Value="#354153" />
<Setter Property="Padding" Value="10,8" />
<Setter Property="MinHeight" Value="36" />
<Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
    <Border x:Name="Field" CornerRadius="10" Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" />
    </Border>
    <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="#78654E" /></Trigger>
        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="#D6AA70" /></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Field" Property="Opacity" Value=".55" /></Trigger>
    </ControlTemplate.Triggers>
</ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="CheckBox"><Setter Property="Foreground" Value="{StaticResource Text}" />
<Setter Property="Margin" Value="0,0,0,12" />
<Setter Property="Cursor" Value="Hand" /><Setter Property="Template">
    <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
            <Grid Background="Transparent">
                <Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Border x:Name="Track" Width="32" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center"
                        Background="#2B2932" BorderBrush="#544D5B" BorderThickness="1" CornerRadius="9">
                    <Ellipse x:Name="Knob" Fill="#C2BBC6" Width="12" Height="12" Margin="2,0"
                             HorizontalAlignment="Left" VerticalAlignment="Center" />
                </Border>
                <ContentPresenter Grid.Column="1" Margin="5,0,0,0" VerticalAlignment="Center"
                                  RecognizesAccessKey="True" />
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Track" Property="Background" Value="#CFA066" />
                    <Setter TargetName="Track" Property="BorderBrush" Value="#CFA066" />
                    <Setter TargetName="Knob" Property="Fill" Value="{StaticResource AccentInk}" />
                    <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Text}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Track" Property="Opacity" Value=".55" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </Setter.Value>
</Setter>
</Style>
<Style x:Key="SidebarLink" TargetType="ListBoxItem">
    <Setter Property="Foreground" Value="{StaticResource Muted}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
        <Border x:Name="Row" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                CornerRadius="12" Margin="0,0,0,4">
            <Grid Height="39">
                <Border x:Name="HoverFill" CornerRadius="11" Background="{StaticResource Panel}" Opacity="0" />
                <Border x:Name="ActiveMark" Width="3" Height="17" CornerRadius="1.5" HorizontalAlignment="Left" Margin="2,0,0,0" Background="{StaticResource Accent}" Visibility="Collapsed" />
                <ContentPresenter Margin="12,0" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                    <DoubleAnimation Storyboard.TargetName="HoverFill" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:.12" />
                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                    <DoubleAnimation Storyboard.TargetName="HoverFill" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:.12" />
                </Storyboard></BeginStoryboard></Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Text}" />
                <Setter TargetName="Row" Property="Background" Value="{StaticResource Panel}" />
                <Setter TargetName="ActiveMark" Property="Visibility" Value="Visible" />
                <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource Line}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource Accent}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
</Style>

<Style x:Key="ScrollTrackButton" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton">
        <Border Background="Transparent" />
    </ControlTemplate></Setter.Value></Setter>
</Style>
<Style x:Key="ScrollThumb" TargetType="Thumb">
    <Setter Property="MinHeight" Value="16" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb">
        <Border x:Name="Grip" Background="#45566D" CornerRadius="4" Margin="2" />
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="{StaticResource Hover}" /></Trigger>
            <Trigger Property="IsDragging" Value="True"><Setter TargetName="Grip" Property="Background" Value="{StaticResource Accent}" /></Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
</Style>
<Style TargetType="ScrollBar">
    <Style.Triggers><Trigger Property="Orientation" Value="Vertical">
        <Setter Property="Width" Value="10" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
            <Border Background="{StaticResource Canvas}">
                <Track x:Name="PART_Track" IsDirectionReversed="True" Focusable="False">
                    <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollTrackButton}" /></Track.DecreaseRepeatButton>
                    <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}" /></Track.Thumb>
                    <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollTrackButton}" /></Track.IncreaseRepeatButton>
                </Track>
            </Border>
        </ControlTemplate></Setter.Value></Setter>
    </Trigger></Style.Triggers>
</Style>
<Style x:Key="SoftCard" TargetType="Border" BasedOn="{StaticResource Card}">
    <Setter Property="Background" Value="{StaticResource Inset}" />
    <Setter Property="Padding" Value="16" />
</Style>
<Style x:Key="LibraryTile" TargetType="Border" BasedOn="{StaticResource SoftCard}">
    <Setter Property="Padding" Value="8" />
    <Setter Property="RenderTransform"><Setter.Value><TranslateTransform /></Setter.Value></Setter>
    <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
            <Setter Property="BorderBrush" Value="{StaticResource Hover}" />
        </Trigger>
        <Trigger Property="IsKeyboardFocusWithin" Value="True">
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
        </Trigger>
        <Trigger Property="IsMouseOver" Value="True">
            <Trigger.EnterActions><BeginStoryboard><Storyboard>
                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="-2" Duration="0:0:.12" />
            </Storyboard></BeginStoryboard></Trigger.EnterActions>
            <Trigger.ExitActions><BeginStoryboard><Storyboard>
                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:.12" />
            </Storyboard></BeginStoryboard></Trigger.ExitActions>
        </Trigger>
    </Style.Triggers>
</Style>
<Style x:Key="HoverPlay" TargetType="Button" BasedOn="{StaticResource Primary}">
    <Setter Property="Opacity" Value=".58" />
    <Style.Triggers>
        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border, AncestorLevel=1}}" Value="True">
            <DataTrigger.EnterActions><BeginStoryboard><Storyboard>
                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:.12" />
            </Storyboard></BeginStoryboard></DataTrigger.EnterActions>
            <DataTrigger.ExitActions><BeginStoryboard><Storyboard>
                <DoubleAnimation Storyboard.TargetProperty="Opacity" To=".58" Duration="0:0:.12" />
            </Storyboard></BeginStoryboard></DataTrigger.ExitActions>
        </DataTrigger>
        <Trigger Property="IsKeyboardFocusWithin" Value="True">
            <Trigger.EnterActions><BeginStoryboard><Storyboard>
                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:.12" />
            </Storyboard></BeginStoryboard></Trigger.EnterActions>
            <Trigger.ExitActions><BeginStoryboard><Storyboard>
                <DoubleAnimation Storyboard.TargetProperty="Opacity" To=".58" Duration="0:0:.12" />
            </Storyboard></BeginStoryboard></Trigger.ExitActions>
        </Trigger>
    </Style.Triggers>
</Style>
<Style x:Key="Badge" TargetType="Border">
    <Setter Property="Background" Value="#293447" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="9,5" />
</Style>
<Style x:Key="IconText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="Foreground" Value="{StaticResource Amber}" />
    <Setter Property="VerticalAlignment" Value="Center" />
</Style>
<Style x:Key="GameContextMenu" TargetType="ContextMenu">
    <Setter Property="Background" Value="{StaticResource Panel}" />
    <Setter Property="Foreground" Value="{StaticResource Text}" />
    <Setter Property="BorderBrush" Value="{StaticResource Line}" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu">
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="1" CornerRadius="10" Padding="5">
            <ItemsPresenter />
        </Border>
    </ControlTemplate></Setter.Value></Setter>
</Style>
<Style x:Key="GameMenuItem" TargetType="MenuItem">
    <Setter Property="Foreground" Value="{StaticResource Text}" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
        <Border x:Name="Item" Background="Transparent" CornerRadius="6" Padding="11,7">
            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Item" Property="Background" Value="{StaticResource Inset}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Item" Property="Opacity" Value=".45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
</Style>
<ItemsPanelTemplate x:Key="WrapCards"><WrapPanel /></ItemsPanelTemplate>
<ItemsPanelTemplate x:Key="EqualColumns"><UniformGrid Rows="1" /></ItemsPanelTemplate>
</ResourceDictionary>
