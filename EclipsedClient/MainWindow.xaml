<Window x:Class="EclipsedClient.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:EclipsedClient.ViewModels" xmlns:views="clr-namespace:EclipsedClient.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Eclipsed Client Solarious" Icon="Assets/Solarious.ico" Width="1240" Height="790" MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterScreen" WindowStyle="None" Background="{StaticResource Canvas}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" UseLayoutRounding="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="7" GlassFrameThickness="0" CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:HomeViewModel}"><views:HomeView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DiscoverViewModel}"><views:DiscoverView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:PlaytimeViewModel}"><views:PlaytimeView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DiscordViewModel}"><views:DiscordView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:GalleryViewModel}"><views:GalleryView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:NetworkViewModel}"><views:NetworkView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView /></DataTemplate>
    </Window.Resources>
    <Border x:Name="WindowFrame" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="16" Background="{StaticResource Canvas}">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="42" /><RowDefinition Height="55" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Border Background="{StaticResource Rail}">
                <DockPanel Margin="19,0,7,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Content="&#xE921;" Click="Minimize" Style="{StaticResource ChromeButton}" AutomationProperties.Name="Minimize" ToolTip="Minimize" />
                        <Button x:Name="MaxButton" Content="&#xE922;" Click="Maximize" Style="{StaticResource ChromeButton}" AutomationProperties.Name="Maximize or restore" ToolTip="Maximize or restore" />
                        <Button Content="&#xE8BB;" Click="CloseWindow" Style="{StaticResource ChromeButton}" AutomationProperties.Name="Close" ToolTip="Close" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="/Assets/solarious.png" Width="21" Height="21" Margin="0,0,10,0" />
                        <TextBlock Text="Eclipsed Client Solarious" FontSize="14" FontWeight="SemiBold" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Grid.Row="1" Background="{StaticResource Rail}" BorderBrush="{StaticResource Line}" BorderThickness="0,1">
                <DockPanel Margin="25,0">
                    <Button DockPanel.Dock="Right" Command="{Binding OpenDiscover}" VerticalAlignment="Center" Margin="10,0,0,0"
                            Padding="9,5" ToolTip="Find a Roblox profile or manage bookmarks" AutomationProperties.Name="Roblox profiles and friends">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="23" Height="23" Margin="0,0,8,0">
                                <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Muted}"
                                           VerticalAlignment="Center" HorizontalAlignment="Center" />
                                <Image Source="{Binding Home.Avatar}" />
                            </Grid>
                            <TextBlock Text="{Binding Home.ProfileName}" VerticalAlignment="Center" MaxWidth="145"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Button>
                    <ListBox ItemsSource="{Binding Pages}" SelectedItem="{Binding Selected}" ItemContainerStyle="{StaticResource HeaderTab}"
                             Background="Transparent" BorderThickness="0" Padding="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             AutomationProperties.Name="Launcher navigation">
                        <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                        <ListBox.ItemTemplate><DataTemplate>
                            <TextBlock Text="{Binding Label}" TextWrapping="NoWrap" />
                        </DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <ScrollViewer Grid.Row="2" x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ContentControl x:Name="PageContent" Content="{Binding Selected.Page}" />
            </ScrollViewer>
            <StackPanel Grid.Row="3" Margin="28,0,28,0">
                <Border Style="{StaticResource SoftCard}" Margin="0,5,0,11" Padding="10"
                        Visibility="{Binding ShowLaunchStatus, Converter={StaticResource BoolVisible}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Dismiss" Command="{Binding DismissLaunch}" Padding="8,3"
                                Visibility="{Binding CanDismissLaunch, Converter={StaticResource BoolVisible}}" />
                        <Button DockPanel.Dock="Right" Content="Open Roblox page" Command="{Binding OpenRobloxPage}" Margin="0,0,6,0"
                                Visibility="{Binding ShowBrowser, Converter={StaticResource BoolVisible}}" />
                        <StackPanel VerticalAlignment="Center">
                            <ProgressBar Width="74" Height="3" HorizontalAlignment="Left" Margin="0,0,0,5" IsIndeterminate="{Binding LaunchPending}"
                                         Foreground="{StaticResource Accent}" Visibility="{Binding LaunchPending, Converter={StaticResource BoolVisible}}" />
                            <TextBlock Text="{Binding LaunchStatus}" AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <TextBlock Text="{Binding Status}" Foreground="{StaticResource Amber}" Margin="0,0,0,11" AutomationProperties.LiveSetting="Polite">
                    <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                        <Style.Triggers><DataTrigger Binding="{Binding Status}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger></Style.Triggers>
                    </Style></TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Grid>
    </Border>
</Window>
