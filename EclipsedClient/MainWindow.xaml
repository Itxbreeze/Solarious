<Window x:Class="EclipsedClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:EclipsedClient.ViewModels"
        xmlns:views="clr-namespace:EclipsedClient.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Solarious" Icon="Assets/Solarious.ico" Width="1180" Height="760"
        MinWidth="880" MinHeight="624" WindowStartupLocation="CenterScreen" WindowStyle="None"
        Background="{StaticResource Canvas}" FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13" UseLayoutRounding="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="7" GlassFrameThickness="0" CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:HomeViewModel}"><views:HomeView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DiscoverViewModel}"><views:DiscoverView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:PlaytimeViewModel}"><views:PlaytimeView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DiscordViewModel}"><views:DiscordView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:GalleryViewModel}"><views:GalleryView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:NetworkViewModel}"><views:NetworkView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView /></DataTemplate>
    </Window.Resources>
    <Border x:Name="WindowFrame" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="16" Background="{StaticResource Canvas}">
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="204" /><ColumnDefinition /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="42" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

            <Border Grid.RowSpan="3" Background="{StaticResource Rail}" BorderBrush="{StaticResource Line}"
                    BorderThickness="1" CornerRadius="14" Margin="10" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="72" />
                        <RowDefinition />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="6,0" VerticalAlignment="Center">
                        <Image Source="/Assets/solarious.png" Width="40" Height="40" Margin="0,0,9,0"
                               AutomationProperties.Name="Solarious logo" />
                        <TextBlock Text="Solarious" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <ListBox Grid.Row="1" ItemsSource="{Binding Pages}" SelectedItem="{Binding Selected}"
                             ItemContainerStyle="{StaticResource SidebarLink}" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                             AutomationProperties.Name="Launcher navigation">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" Width="30" FontSize="15" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Label}" TextWrapping="NoWrap" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="2">
                        <Button Command="{Binding OpenDiscover}" Style="{StaticResource ProfileButton}"
                                ToolTip="Open public Roblox profiles" AutomationProperties.Name="Public Roblox profile">
                            <StackPanel Orientation="Horizontal">
                                <Border Background="{StaticResource Rail}" CornerRadius="8" Width="31" Height="31" Margin="0,0,8,0">
                                    <Grid>
                                        <TextBlock Text="&#xE77B;" Style="{StaticResource IconText}" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                        <Image Source="{Binding Home.Avatar}" />
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding Home.ProfileName}" MaxWidth="90" TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding Launch}" Style="{StaticResource Primary}" Content="▶  PLAY ROBLOX"
                                Height="45" Margin="0,10,0,0" AutomationProperties.Name="Play Roblox"
                                ToolTip="Open the installed official Roblox player" />
                        <TextBlock Text="0 Trackers • Local Only" FontSize="10" Foreground="{StaticResource Muted}"
                                   HorizontalAlignment="Center" Margin="0,12,0,1" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource Canvas}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                <DockPanel Margin="20,0,7,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Content="&#xE921;" Click="Minimize" Style="{StaticResource ChromeButton}" AutomationProperties.Name="Minimize" ToolTip="Minimize" />
                        <Button x:Name="MaxButton" Content="&#xE922;" Click="Maximize" Style="{StaticResource ChromeButton}"
                                AutomationProperties.Name="Maximize or restore" ToolTip="Maximize or restore" />
                        <Button Content="&#xE8BB;" Click="CloseWindow" Style="{StaticResource ChromeButton}" AutomationProperties.Name="Close" ToolTip="Close" />
                    </StackPanel>
                    <TextBlock Text="{Binding Selected.Label}" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Column="1" Grid.Row="1" x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ContentControl x:Name="PageContent" Content="{Binding Selected.Page}" Margin="16,16,22,20" MaxWidth="1180" />
            </ScrollViewer>
            <StackPanel Grid.Column="1" Grid.Row="2" Margin="20,0,20,0">
                <Border Style="{StaticResource SoftCard}" Margin="0,0,0,12"
                        Visibility="{Binding ShowLaunchStatus, Converter={StaticResource BoolVisible}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Dismiss" Command="{Binding DismissLaunch}"
                                Visibility="{Binding CanDismissLaunch, Converter={StaticResource BoolVisible}}" />
                        <Button DockPanel.Dock="Right" Content="Open Roblox page" Command="{Binding OpenRobloxPage}" Margin="0,0,7,0"
                                Visibility="{Binding ShowBrowser, Converter={StaticResource BoolVisible}}" />
                        <StackPanel VerticalAlignment="Center" Margin="0,0,7,0">
                            <ProgressBar Width="74" Height="3" HorizontalAlignment="Left" Margin="0,0,0,5"
                                         IsIndeterminate="{Binding LaunchPending}" Foreground="{StaticResource Accent}"
                                         Visibility="{Binding LaunchPending, Converter={StaticResource BoolVisible}}" />
                            <TextBlock Text="{Binding LaunchStatus}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <TextBlock Text="{Binding Status}" Foreground="{StaticResource Amber}" Margin="0,0,0,10" AutomationProperties.LiveSetting="Polite">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Style.Triggers><DataTrigger Binding="{Binding Status}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger></Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Grid>
    </Border>
</Window>
